#!/usr/bin/env bash
# Pre-commit hook: Nix lint/format gate + knowledge-graph gate.
#
# The Nix checks live in scripts/task/nix-fmt.sh — the SAME script behind
# `task checks:nix:lint`, `checks:nix:format` and `checks:nix:fix`. That is
# deliberate: there is exactly ONE place that resolves tool versions, so the gate
# judging your commit cannot drift from the task you just ran locally. The script
# prefers tools already on PATH (shipped by base-node.nix) and otherwise fetches
# them once from the nixpkgs revision pinned in flake.lock, cached as GC-rooted
# out-links that it shares with the watcher.
#
# The graph gate is scripts/task/kg-check.sh — the same script behind
# `task checks:kg`. It runs only when the staged paths can affect the graph,
# because the projection is compiled from files and most commits do not touch
# them (see affects_graph below). Where it does run, a schema change that
# silently empties every pattern is refused here instead of being discovered at
# question time by someone who believes a blank answer.
#
# Gates, matching the repo's stated policy:
#   deadnix   HARD      staged files must contain no dead code
#   alejandra HARD      staged files must be alejandra-formatted
#   statix    ADVISORY  reported, never blocks — its W20 repeated-key warning
#                       fires on this repo's house style
#   blobs     HARD      a staged blob over 512 KiB is refused
#                       (scripts/task/repo-blobs.sh --index)
#   checks:kg HARD      graph schema + all patterns, when they are affected
#   census    HARD      `.nix` prose lines may not exceed the recorded ceiling
#   task-descs HARD     a task added to a taskfile must be visible somewhere
#
# Fail-closed: if the formatter cannot be resolved, nix-fmt.sh exits non-zero and
# the commit is refused, rather than silently skipping the format check. The same
# applies to the graph gate — a projection that cannot be evaluated is a real
# finding, not a reason to skip.

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
NIX_FMT="$REPO_ROOT/scripts/task/nix-fmt.sh"
KG_CHECK="$REPO_ROOT/scripts/task/kg-check.sh"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
STAGED_NIX=$(grep '\.nix$' <<<"$STAGED" || true)

# Everything that feeds `.#knowledgeGraph`. The projection reads only these, so
# anything else — a host module, another taskfile, a script outside the kg family
# — cannot make the graph gate fail for a reason the author did not cause.
affects_graph() {
  local f
  while IFS= read -r f; do
    case "$f" in
      inventory.toml | AGENTS.md | MANUAL.md | ARCHITECTURE.md | AUDIT.md | TODO.md | HANDOFF.md | EXPERIMENTS.md | README.md)
        return 0
        ;;
      docs/*.md) return 0 ;; # non-recursive, matching lib/knowledge-graph.nix
      .agents/skills/*) return 0 ;;
      lib/knowledge-graph.nix | lib/skills.nix | lib/inventory.nix) return 0 ;;
      scripts/task/kg-*.sh | scripts/task/lib/kg-graph.sh) return 0 ;;
      flake/outputs.nix | taskfiles/*.yml) return 0 ;;
    esac
  done <<<"${1:-}"
  return 1
}

# The ontology gate (flake/ontology.nix -> task checks:ontology) is the only thing
# that proves the compiled graph is an instance of its declared types: an undeclared
# node or edge type, a declaration the graph stopped populating, an edge outside its
# relation's domain, or a stable claim kind with no home. It costs one graph eval and
# builds nothing, and it can only be wrong when the contract or the emitter moved —
# so it is scoped to those files instead of every commit.
affects_ontology() {
  local f
  while IFS= read -r f; do
    case "$f" in
      flake/ontology.nix | flake/epistemics.nix | lib/knowledge-graph.nix | lib/agents-notes.nix) return 0 ;;
    esac
  done <<<"${1:-}"
  return 1
}

BLOB_GATE="$REPO_ROOT/scripts/task/repo-blobs.sh"

# A blob is permanent: deleting the file later leaves the object and costs a
# rewrite of every commit. This is the only moment the cost is zero, so it runs
# on every commit that stages anything, not just the Nix ones.
if [ -n "$STAGED" ]; then
  if [ ! -f "$BLOB_GATE" ]; then
    echo "pre-commit: $BLOB_GATE is missing; refusing to skip the blob gate." >&2
    exit 1
  fi
  if ! bash "$BLOB_GATE" --index; then
    echo
    echo "Commit refused: a staged blob is over the size gate."
    echo "  Rule: task checks:repo:blobs   (MAX= / ALLOW= for a deliberate exception)"
    exit 1
  fi
fi

if [ -n "$STAGED_NIX" ]; then
  if [ ! -f "$NIX_FMT" ]; then
    echo "pre-commit: $NIX_FMT is missing; refusing to skip the Nix gate." >&2
    exit 1
  fi

  # Build an array rather than word-splitting $STAGED_NIX, so a path containing a
  # space could never turn into two bogus paths.
  FILES=()
  while IFS= read -r f; do
    [ -n "$f" ] && FILES+=("$f")
  done <<<"$STAGED_NIX"

  echo "Checking staged Nix files..."

  if ! bash "$NIX_FMT" --check --tools deadnix,statix,alejandra "${FILES[@]}"; then
    echo
    echo "Commit refused: the hard gate above failed."
    echo "  Fix with: task checks:nix:fix"
    echo "  (statix findings are advisory and never block a commit.)"
    exit 1
  fi

  echo "Nix checks passed."
fi

# The comment census is a shrink-only ratchet: a `.nix` file may not carry one
# more prose line than `flake/nix-comments.nix` records. It is one eval and no
# build, so it runs on every commit that stages a `.nix` — the failure mode is a
# ceiling raised by accident in a commit whose diff looked like a one-line edit
# and whose author never ran `checks:policies`.
if [ -n "$STAGED_NIX" ]; then
  HEADER="$(nix eval .#nixComments.header 2>/dev/null || true)"
  CEILING="$(nix eval .#nixComments.ceiling 2>/dev/null || true)"
  if ! [[ "$HEADER" =~ ^[0-9]+$ && "$CEILING" =~ ^[0-9]+$ ]]; then
    echo "pre-commit: the comment census could not be read; refusing to skip it." >&2
    exit 1
  fi
  if [ "$HEADER" -gt "$CEILING" ]; then
    echo "Commit refused: Nix comment lines ${HEADER} > ceiling ${CEILING}." >&2
    echo "  A comment must be a pointer: a path, a task name, a policy id, an attr." >&2
    echo "  Where the prose is: nix eval --json .#nixComments.headerPerFile | jq 'to_entries|sort_by(-.value)|.[:5]'" >&2
    echo "  Rule: flake/policies.nix#nix-comments-are-pointers" >&2
    exit 1
  fi
  echo "Comment census ${HEADER}/${CEILING}."
fi

# A task that arrives without a desc and without a summary is invisible in both
# `task --list` and `task --list-all --json`. The gate is cheap (one trivial
# derivation), and a taskfile change is exactly when it can go wrong.
if grep -Eq '^(taskfiles/.*\.yml|flake/outputs\.nix)$' <<<"$STAGED"; then
  echo "Checking that every task is visible to a person or an agent..."
  SYS="$(nix eval --impure --raw --expr builtins.currentSystem 2>/dev/null || true)"
  if [ -z "$SYS" ] || ! nix build --impure --no-link --builders "" ".?submodules=1#checks.$SYS.task-descs" >/tmp/pre-commit-task-descs.log 2>&1; then
    echo "pre-commit: the task visibility gate failed or could not run; refusing to skip it." >&2
    sed 's/^/  /' /tmp/pre-commit-task-descs.log 2>/dev/null | tail -20
    echo "  Run it alone: task check:leaf NAME=checks:task-descs"
    exit 1
  fi
  echo "Task visibility passed."
fi

if affects_graph "$STAGED"; then
  if [ ! -f "$KG_CHECK" ]; then
    echo "pre-commit: $KG_CHECK is missing; refusing to skip the graph gate." >&2
    exit 1
  fi

  echo "Checking the knowledge graph (staged changes touch what it is built from)..."

  if ! bash "$KG_CHECK"; then
    echo
    echo "Commit refused: the knowledge graph gate failed."
    echo "  A schema change that empties every pattern is a silent failure; the"
    echo "  gate is what makes it loud. Reproduce with: task checks:kg"
    exit 1
  fi

  echo "Graph checks passed."
fi

if affects_ontology "$STAGED"; then
  echo "Checking the graph against its ontology (staged changes touch the type contract)..."
  SYS="$(nix eval --impure --raw --expr builtins.currentSystem 2>/dev/null || true)"
  if [ -z "$SYS" ] || ! nix build --impure --no-link --builders "" ".?submodules=1#checks.$SYS.ontology" >/tmp/pre-commit-ontology.log 2>&1; then
    echo "pre-commit: the ontology gate failed or could not run; refusing to skip it." >&2
    sed 's/^/  /' /tmp/pre-commit-ontology.log 2>/dev/null | tail -20
    echo "  Run it alone: task check:leaf NAME=checks:ontology"
    exit 1
  fi
  echo "Ontology checks passed."
fi

if grep -Eq '^(\.agents/skills/router/|lib/knowledge-graph\.nix)' <<<"$STAGED"; then
  echo "Checking the router's labels against its playbooks..."
  SYS="$(nix eval --impure --raw --expr builtins.currentSystem 2>/dev/null || true)"
  if [ -z "$SYS" ] || ! nix build --impure --no-link --builders "" ".?submodules=1#checks.$SYS.router-labels" >/tmp/pre-commit-router.log 2>&1; then
    echo "pre-commit: the router label gate failed or could not run; refusing to skip it." >&2
    sed 's/^/  /' /tmp/pre-commit-router.log 2>/dev/null | tail -20
    echo "  Run it alone: task check:leaf NAME=checks:router"
    exit 1
  fi
  echo "Router labels passed."
fi

# Pre-flight blast radius: INFORMATION, never a gate. A commit that touches a
# host directory, a living document or a skill changes what some other node
# claims; printing the dependents here costs ~0.5 s (or ~1 ms per anchor when the
# sidecar is already up) and is the moment when that is still cheap to act on.
# It runs through scripts/task/kg-preflight.sh, the same script behind
# `task checks:blast`, and is advisory by construction: a projection is not a
# dependency graph, so it must never refuse a commit.
if grep -Eq '^(hosts/|docs/|\.agents/skills/|AGENTS\.md|MANUAL\.md|ARCHITECTURE\.md|AUDIT\.md|README\.md)' <<<"$STAGED"; then
  if [ -f "$REPO_ROOT/scripts/task/kg-preflight.sh" ]; then
    bash "$REPO_ROOT/scripts/task/kg-preflight.sh" --staged --advisory 2>/dev/null || true
  fi
fi

# The small pinned datasets — the turn snapshot and the resume — are files Nix
# reads, and a stale one is a build that describes yesterday. Refreshed here and
# not at push time: a push hook that commits has to push again, because git read
# the ref before the hook ran, and the push it was called for then fails as a
# rejected ref. A commit is the last moment the refresh is free. It stages what it
# changed, so the data travels with the commit that caused it, and it is advisory:
# an unreachable source must warn, never block a commit.
if [ -f "$REPO_ROOT/scripts/task/pins-refresh.sh" ]; then
  if bash "$REPO_ROOT/scripts/task/pins-refresh.sh" >/tmp/pre-commit-pins.log 2>&1; then
    grep -E '^(PIN|HASH|SKIP) ' /tmp/pre-commit-pins.log | sed 's/^/  /' | head -12 || true
  else
    echo "  pre-commit: the pin refresh could not run; the pinned files are unchanged."
  fi
fi

exit 0
