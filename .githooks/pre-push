#!/usr/bin/env bash
# Pre-push: two of the gates in CI's `docs-budget` job, plus two that CI cannot run
# at all — the blob-size gate, and the gallery manifest, whose source rows live
# outside the repo so only a machine that has them can compare the two.
#
# Every red run on main costs a mail and a context switch, and on this tree that
# job is where a change lands red: a taskfile shard that no longer compiles to the
# graph go-task sees, a living document over budget. Both are answered here in
# a few seconds, and `scripts/task/repo-blobs.sh` adds the one check no CI step
# makes — a >512 KiB blob entering the remote, which only a rewrite can undo. The
# job's other two steps (prose tells, module edges) stay in CI. CI keeps running
# everything either way (a `--no-verify` push must still be caught), so this only
# moves the answer to where the change is still in hand.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# git writes the refs being pushed here (local ref, local sha, remote ref, remote
# sha). Captured once, up front: the blob gate needs them, and a gate that runs
# before it must not be able to eat them.
refs=$(mktemp)
trap 'rm -f "$refs"' EXIT
cat >"$refs"

status=0

if [ -f scripts/task/docs-budget.sh ]; then
  if ! bash scripts/task/docs-budget.sh >/tmp/pre-push-docs-budget.log 2>&1; then
    echo "pre-push: a living document is over budget:"
    sed 's/^/  /' /tmp/pre-push-docs-budget.log | tail -20
    status=1
  fi
fi

# Blobs are checked here as well as in pre-commit: `--no-verify` on a commit, an
# amend after the hook, or a branch built elsewhere all reach the push with an
# index the commit hook never saw. Only what this push adds counts. The legacy
# blobs already on the server are the `--history` audit's business: no push can
# remove them, and refusing every push over them just teaches --no-verify.
if [ -f scripts/task/repo-blobs.sh ]; then
  if ! bash scripts/task/repo-blobs.sh --push <"$refs" >/tmp/pre-push-blobs.log 2>&1; then
    echo "pre-push: a blob over 512 KiB would enter the remote with this push:"
    grep -E 'OVER|push:' /tmp/pre-push-blobs.log | sed 's/^/  /'
    echo "  task checks:repo:blobs explains the rule; removing a pushed blob needs a rewrite."
    status=1
  fi
fi

# The gallery's manifest is derived from a file outside the repo, so no CI step
# compares the two: a stale or half-built manifest is what `images:publish` then
# ships to the frontend, with no red run to say so. Where the asset root is absent
# the script says that and exits 0, so a keyless clone pays nothing.
if [ -f scripts/task/images-check.sh ]; then
  if ! bash scripts/task/images-check.sh >/tmp/pre-push-images.log 2>&1; then
    echo "pre-push: the image manifest no longer matches its source rows:"
    sed 's/^/  /' /tmp/pre-push-images.log | tail -20
    echo "  Rebuild it: task images:publish   (see it alone: task checks:images)"
    status=1
  fi
fi

# The task graph gate: yq parses the shards, python applies the rules, go-task is
# the oracle for the name set. ~3 s, no eval, no build, no host — 1.9 s of it is
# go-task's own `--list-all --json`.
if command -v yq >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  if ! bash scripts/task/taskfile-graph.sh >/tmp/pre-push-task-graph.log 2>&1; then
    echo "pre-push: the task graph gate failed:"
    sed 's/^/  /' /tmp/pre-push-task-graph.log | tail -25
    echo "  task checks:tasks explains every bucket."
    status=1
  fi
else
  echo "pre-push: yq or python3 not on PATH — the task graph gate was not run."
fi

if [ "$status" -ne 0 ]; then
  echo
  echo "Push refused. This is the same gate CI runs as 'docs-budget'; fixing it here"
  echo "is one line instead of one failed run. Bypass deliberately with --no-verify."
fi

exit "$status"
