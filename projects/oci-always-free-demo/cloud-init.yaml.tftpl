#cloud-config
package_update: true
packages:
  - python3
  - python3-pip
  - unzip

write_files:
  - path: /etc/todo.env
    permissions: "0644"
    owner: root:root
    content: |
      BUCKET_NAMESPACE=${bucket_namespace}
      BUCKET_NAME=${bucket_name}
      APP_OBJECT=${app_object}
      WALLET_OBJECT=${wallet_object}
      ADB_USER=${db_user}
      ADB_TNS_ALIAS=${db_alias}
      ADB_WALLET_DIR=/opt/todo/wallet
      ADB_PASSWORD_SECRET_OCID=${secret_ocid}
      PORT=${app_port}

  - path: /etc/systemd/system/todo.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Always Free to-do demo (Flask + Autonomous Database)
      After=network-online.target
      Wants=network-online.target
      StartLimitIntervalSec=0

      [Service]
      Type=simple
      User=todo
      Group=todo
      EnvironmentFile=/etc/todo.env
      ExecStart=/opt/todo/venv/bin/python /opt/todo/app.py
      Restart=always
      RestartSec=15
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectSystem=full
      ProtectHome=true

      [Install]
      WantedBy=multi-user.target

  - path: /opt/todo/bootstrap.py
    permissions: "0700"
    owner: root:root
    content: |
      """Fetch the app source and the mTLS wallet with instance principals."""

      import base64
      import pathlib
      import subprocess
      import time
      import zipfile

      import oci
      from oci.object_storage import ObjectStorageClient

      APP_DIR = pathlib.Path("/opt/todo")
      ENV = {}
      for line in pathlib.Path("/etc/todo.env").read_text().splitlines():
          if "=" in line and not line.startswith("#"):
              key, value = line.split("=", 1)
              ENV[key.strip()] = value.strip()


      def fetch(client, name):
          for attempt in range(1, 31):
              try:
                  return client.get_object(
                      ENV["BUCKET_NAMESPACE"], ENV["BUCKET_NAME"], name
                  ).data.content
              except Exception as exc:
                  print("read %s failed (attempt %d): %s" % (name, attempt, exc), flush=True)
                  time.sleep(10)
          raise SystemExit("cannot read object %s" % name)


      signer = oci.auth.signers.InstancePrincipalsSecurityTokenSigner()
      storage = ObjectStorageClient({}, signer=signer)

      (APP_DIR / "app.py").write_bytes(fetch(storage, ENV["APP_OBJECT"]))

      archive_path = pathlib.Path("/tmp/wallet.zip")
      archive_path.write_bytes(base64.b64decode(fetch(storage, ENV["WALLET_OBJECT"])))
      wallet_dir = APP_DIR / "wallet"
      wallet_dir.mkdir(parents=True, exist_ok=True)
      with zipfile.ZipFile(archive_path) as archive:
          archive.extractall(wallet_dir)
      archive_path.unlink()

      for path in wallet_dir.iterdir():
          path.chmod(0o600)
      wallet_dir.chmod(0o700)

      subprocess.run(["chown", "-R", "todo:todo", str(APP_DIR)], check=True)
      print("bootstrap complete", flush=True)

runcmd:
  - useradd --system --home-dir /opt/todo --shell /sbin/nologin todo || true
  - mkdir -p /opt/todo/wallet
  - python3 -m venv /opt/todo/venv
  - /opt/todo/venv/bin/pip install --no-cache-dir --upgrade pip
  - /opt/todo/venv/bin/pip install --no-cache-dir flask waitress oracledb oci
  - /opt/todo/venv/bin/python /opt/todo/bootstrap.py
  - systemctl daemon-reload
  - systemctl enable --now todo
