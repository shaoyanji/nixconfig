<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NixOS Build Tracker</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #0f1115;
        --panel: #171a21;
        --line: #262b36;
        --text: #e6e9ef;
        --muted: #8b94a7;
        --accent: #7aa2f7;
        --ok: #9ece6a;
        --err: #f7768e;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
        font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      header {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
        border-bottom: 1px solid var(--line);
      }
      h1 { font-size: 17px; margin: 0; font-weight: 600; letter-spacing: 0.2px; }
      h1 span { color: var(--accent); }
      main { max-width: 860px; margin: 0 auto; padding: 28px 24px 64px; }
      section { margin-bottom: 28px; }
      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 18px 20px;
      }
      p.lede { color: var(--muted); margin: 0 0 16px; }
      button {
        font: inherit;
        border-radius: 7px;
        border: 1px solid var(--line);
        background: #1e2229;
        color: var(--text);
        padding: 8px 14px;
        cursor: pointer;
      }
      button:hover { border-color: var(--accent); }
      button.primary { background: var(--accent); border-color: var(--accent); color: #0b0e13; font-weight: 600; }
      button:disabled { opacity: 0.5; cursor: not-allowed; }
      form { display: grid; gap: 12px; }
      label { display: grid; gap: 6px; font-size: 13px; color: var(--muted); }
      input, textarea {
        font: inherit;
        color: var(--text);
        background: #0f1218;
        border: 1px solid var(--line);
        border-radius: 7px;
        padding: 9px 11px;
        width: 100%;
      }
      input:focus, textarea:focus { outline: 2px solid rgba(122, 162, 247, 0.35); border-color: var(--accent); }
      textarea { resize: vertical; min-height: 62px; }
      .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { color: var(--muted); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; }
      td.hash { font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", monospace; font-size: 13px; word-break: break-all; }
      td.when { color: var(--muted); white-space: nowrap; font-size: 13px; }
      .empty { color: var(--muted); padding: 18px 0; text-align: center; }
      .status { min-height: 22px; font-size: 13px; }
      .status.ok { color: var(--ok); }
      .status.err { color: var(--err); }
      .muted { color: var(--muted); }
      code { font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", monospace; font-size: 12.5px; background: #0f1218; padding: 1px 5px; border-radius: 4px; }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <header>
      <h1>NixOS <span>Build Tracker</span></h1>
      <div class="row">
        <span id="who" class="muted"></span>
        <button id="signin" type="button">Sign in</button>
        <button id="signout" type="button" hidden>Sign out</button>
      </div>
    </header>

    <main>
      <section id="signed-out" class="card" hidden>
        <p class="lede">Track NixOS configuration hashes and Git commits, and check them back for reproducibility later.</p>
        <p class="lede">Sign in with your email address. Your builds are stored per account and only you can read them.</p>
        <button id="signin-body" class="primary" type="button">Sign in with email</button>
      </section>

      <section id="signed-in" hidden>
        <div class="card" style="margin-bottom: 24px">
          <form id="submit-form">
            <label>
              NixOS configuration hash or Git commit
              <input id="hash" name="hash" autocomplete="off" spellcheck="false" placeholder="e.g. 8f2a1c… or sha256-…" required />
            </label>
            <label>
              Description
              <textarea id="description" name="description" placeholder="What did you change?" maxlength="500"></textarea>
            </label>
            <div class="row">
              <button class="primary" type="submit" id="submit">Track build</button>
              <span id="form-status" class="status"></span>
            </div>
          </form>
        </div>

        <div class="card">
          <div class="row" style="justify-content: space-between; margin-bottom: 6px">
            <h2 style="font-size: 14px; margin: 0; color: var(--muted); font-weight: 500">Tracked builds</h2>
            <button id="refresh" type="button">Refresh</button>
          </div>
          <p id="list-status" class="status"></p>
          <table id="builds-table" hidden>
            <thead>
              <tr><th>Hash</th><th>Description</th><th>Tracked</th></tr>
            </thead>
            <tbody id="builds-body"></tbody>
          </table>
          <div id="empty" class="empty" hidden>No builds tracked yet.</div>
        </div>
      </section>

      <p class="muted" style="font-size: 12px">
        Auth: Cognito · API: Lambda Function URL · Data: DynamoDB · <code id="ref-house"></code>
      </p>
    </main>

    <script>
      const CONFIG = {
        apiUrl: "__API_URL__",
        region: "__REGION__",
        clientId: "__CLIENT_ID__",
        hostedUi: "__COGNITO_DOMAIN__",
        redirectUri: "__REDIRECT_URI__",
      };

      const STORAGE_KEY = "nbt.tokens";
      const $ = (id) => document.getElementById(id);

      function readTokens() {
        try {
          return JSON.parse(sessionStorage.getItem(STORAGE_KEY) || "null");
        } catch (err) {
          return null;
        }
      }

      function writeTokens(tokens) {
        if (tokens) sessionStorage.setItem(STORAGE_KEY, JSON.stringify(tokens));
        else sessionStorage.removeItem(STORAGE_KEY);
      }

      function tokenFromHash() {
        if (!location.hash || location.hash.length < 2) return null;
        const params = new URLSearchParams(location.hash.slice(1));
        const idToken = params.get("id_token");
        if (!idToken) return null;
        return {
          idToken,
          accessToken: params.get("access_token"),
          expiresAt: Date.now() + Number(params.get("expires_in") || 3600) * 1000,
        };
      }

      function subjectOf(tokens) {
        if (!tokens || !tokens.idToken) return null;
        try {
          const payload = tokens.idToken.split(".")[1].replace(/-/g, "+").replace(/_/g, "/");
          const padded = payload.padEnd(payload.length + ((4 - (payload.length % 4)) % 4), "=");
          const claims = JSON.parse(decodeURIComponent(escape(atob(padded))));
          return claims.email || claims["cognito:username"] || claims.sub;
        } catch (err) {
          return null;
        }
      }

      function valid(tokens) {
        return !!tokens && !!tokens.idToken && (!tokens.expiresAt || tokens.expiresAt > Date.now());
      }

      function setStatus(el, message, kind) {
        el.textContent = message || "";
        el.className = "status" + (kind ? " " + kind : "");
      }

      function signIn() {
        const params = new URLSearchParams({
          client_id: CONFIG.clientId,
          response_type: "token",
          scope: "openid email profile",
          redirect_uri: CONFIG.redirectUri,
        });
        location.href = CONFIG.hostedUi + "/login?" + params.toString();
      }

      function signOut() {
        writeTokens(null);
        const params = new URLSearchParams({
          client_id: CONFIG.clientId,
          logout_uri: CONFIG.redirectUri,
        });
        location.href = CONFIG.hostedUi + "/logout?" + params.toString();
      }

      async function api(path, options) {
        const tokens = readTokens();
        const response = await fetch(CONFIG.apiUrl + path, {
          ...options,
          headers: {
            "content-type": "application/json",
            authorization: "Bearer " + (tokens ? tokens.idToken : ""),
            ...((options && options.headers) || {}),
          },
        });
        if (response.status === 401) {
          writeTokens(null);
          render();
          throw new Error("session expired — sign in again");
        }
        const text = await response.text();
        let body = null;
        try {
          body = text ? JSON.parse(text) : null;
        } catch (err) {
          body = { error: text };
        }
        if (!response.ok) {
          throw new Error((body && body.error) || "request failed with " + response.status);
        }
        return body;
      }

      function row(build) {
        const tr = document.createElement("tr");

        const hash = document.createElement("td");
        hash.className = "hash";
        hash.textContent = build.buildHash;

        const description = document.createElement("td");
        description.textContent = build.description || "—";

        const when = document.createElement("td");
        when.className = "when";
        const date = new Date(build.createdAt);
        when.textContent = isNaN(date.getTime()) ? build.createdAt : date.toLocaleString();

        tr.append(hash, description, when);
        return tr;
      }

      async function refresh() {
        const status = $("list-status");
        setStatus(status, "Loading…");
        try {
          const data = await api("/builds", { method: "GET" });
          const builds = (data && data.builds) || [];
          const body = $("builds-body");
          body.replaceChildren();
          builds.forEach((build) => body.append(row(build)));
          $("builds-table").hidden = builds.length === 0;
          $("empty").hidden = builds.length !== 0;
          setStatus(status, builds.length ? builds.length + " build(s)" : "");
        } catch (err) {
          $("builds-table").hidden = true;
          $("empty").hidden = true;
          setStatus(status, err.message, "err");
        }
      }

      async function submit(event) {
        event.preventDefault();
        const status = $("form-status");
        const hash = $("hash").value.trim();
        if (!hash) return;
        $("submit").disabled = true;
        setStatus(status, "Saving…");
        try {
          await api("/builds", {
            method: "POST",
            body: JSON.stringify({ buildHash: hash, description: $("description").value.trim() }),
          });
          $("hash").value = "";
          $("description").value = "";
          setStatus(status, "Tracked.", "ok");
          await refresh();
        } catch (err) {
          setStatus(status, err.message, "err");
        } finally {
          $("submit").disabled = false;
        }
      }

      function render() {
        const tokens = readTokens();
        const signedIn = valid(tokens);
        $("signed-in").hidden = !signedIn;
        $("signed-out").hidden = signedIn;
        $("signin").hidden = signedIn;
        $("signout").hidden = !signedIn;
        $("who").textContent = signedIn ? subjectOf(tokens) || "" : "";
        if (signedIn) refresh();
      }

      const fromHash = tokenFromHash();
      if (fromHash) {
        writeTokens(fromHash);
        history.replaceState(null, "", location.pathname + location.search);
      }

      $("signin").addEventListener("click", signIn);
      $("signin-body").addEventListener("click", signIn);
      $("signout").addEventListener("click", signOut);
      $("refresh").addEventListener("click", refresh);
      $("submit-form").addEventListener("submit", submit);

      const house = CONFIG.apiUrl.split("//")[1].split(".")[0];
      $("ref-house").textContent = CONFIG.region + " · " + house;
      render();
    </script>
  </body>
</html>
