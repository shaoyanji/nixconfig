# A structural view of the repo's knowledge, compiled from the files themselves.
#
# Why this exists: BM25 (`qmd`) answers "where is this explained"; it is bad at
# "what touches X" and "which skills mention frieren". A graph answers that in
# one hop. The graph is a *projection*, not a new source of truth:
#
#   hosts   <- inventory.toml (compiled by lib/inventory.nix)
#   skills  <- .agents/skills/*/SKILL.md (compiled by lib/skills.nix)
#   docs    <- root living documents + docs/*.md (markdown, heading only)
#
# Edges are mentions, which are cheap and honest ("this file names that thing").
# No embedding, no LLM, no server. The Cypher export exists so an external Neo4j
# can be fed in one command if the graph ever outgrows `jq`; it does not imply a
# Neo4j process on this host (see ARCHITECTURE.md P3).
{
  lib,
  inventory,
  skills,
}: let
  root = ../.;

  hostNames = builtins.attrNames inventory.hosts;

  rootDocs = map (f: root + "/${f}") [
    "AGENTS.md"
    "MANUAL.md"
    "ARCHITECTURE.md"
    "AUDIT.md"
    "TODO.md"
    "HANDOFF.md"
    "EXPERIMENTS.md"
    "README.md"
  ];

  docsDir = root + "/docs";
  docFiles = map (f: docsDir + "/${f}") (
    builtins.attrNames (
      lib.filterAttrs (n: t: t == "regular" && lib.hasSuffix ".md" n)
      (builtins.readDir docsDir)
    )
  );

  # `docs/generated/` is a build artifact (checks:docs:sync owns it); it is not
  # a knowledge source and would only add duplicate edges.
  files = builtins.filter builtins.pathExists (rootDocs ++ docFiles);

  rel = p: let
    s = toString p;
    r = toString root;
  in
    lib.removePrefix "${r}/" s;

  firstHeading = text: let
    lines = lib.splitString "\n" text;
    hits = builtins.filter (l: lib.hasPrefix "# " l) lines;
  in
    if hits == []
    then "(untitled)"
    else lib.removePrefix "# " (builtins.head hits);

  mkDoc = p: let
    content = builtins.readFile p;
    id = rel p;
  in {
    id = "doc:${id}";
    type = "doc";
    label = firstHeading content;
    path = id;
    mentionsHosts = builtins.filter (h: lib.hasInfix h content) hostNames;
    mentionsSkills = builtins.filter (s: lib.hasInfix s (lib.toLower content)) (builtins.attrNames skills.skills);
  };

  docs = map mkDoc files;

  hostNodes =
    map (h: {
      id = "host:${h}";
      type = "host";
      label = h;
      status = inventory.hosts.${h}.status or "unknown";
      kind = inventory.hosts.${h}.kind or "unknown";
    })
    hostNames;

  skillNodes =
    map (n: {
      id = "skill:${n}";
      type = "skill";
      label = n;
      description = skills.skills.${n}.description;
      path = skills.skills.${n}.path;
      tags = skills.skills.${n}.tags;
    })
    (builtins.attrNames skills.skills);

  nodes =
    hostNodes
    ++ skillNodes
    ++ map (d: {
      inherit (d) id type label path;
    })
    docs;

  edges =
    lib.concatMap (d:
      map (h: {
        from = d.id;
        to = "host:${h}";
        type = "mentions";
      })
      d.mentionsHosts
      ++ map (s: {
        from = d.id;
        to = "skill:${s}";
        type = "mentions";
      })
      d.mentionsSkills)
    docs
    ++ lib.concatMap (n:
      map (t: {
        from = "skill:${n}";
        to = "tag:${t}";
        type = "tagged";
      })
      skills.skills.${n}.tags)
    (builtins.attrNames skills.skills);

  tagNodes = lib.unique (lib.concatMap (n: skills.skills.${n}.tags) (builtins.attrNames skills.skills));

  graph = {
    schemaVersion = 1;
    generatedBy = "lib/knowledge-graph.nix";
    nodes =
      nodes
      ++ map (t: {
        id = "tag:${t}";
        type = "tag";
        label = t;
      })
      tagNodes;
    inherit edges;
    stats = {
      hosts = builtins.length hostNames;
      skills = builtins.length (builtins.attrNames skills.skills);
      docs = builtins.length docs;
      edges = builtins.length edges;
    };
  };

  q = s: builtins.toJSON s;
  cypherNodes =
    lib.concatMapStrings (n: let
      label =
        if n.type == "host"
        then "Host"
        else if n.type == "skill"
        then "Skill"
        else if n.type == "doc"
        then "Doc"
        else "Tag";
    in ''
      MERGE (${"n_${builtins.hashString "md5" n.id}"}:${label} {id: ${q n.id}})
      SET ${"n_${builtins.hashString "md5" n.id}"}.label = ${q n.label};
    '')
    graph.nodes;
  cypherEdges =
    lib.concatMapStrings (e: let
      a = "n_${builtins.hashString "md5" e.from}";
      b = "n_${builtins.hashString "md5" e.to}";
      rel =
        if e.type == "tagged"
        then "TAGGED"
        else "MENTIONS";
    in ''
      MATCH (${a}), (${b}) MERGE (${a})-[:${rel}]->(${b});
    '')
    graph.edges;
in {
  inherit graph;
  json = builtins.toJSON graph;
  cypher = "// generated by lib/knowledge-graph.nix\n" + cypherNodes + cypherEdges;
}
