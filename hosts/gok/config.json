{
    "Hostname": "gok.cloudforest-kardashev.ts.net",
    "Update": {
        "HTTPPassword": ""
    },
    "Environment": [
        "GOOS=linux",
        "GOARCH=arm64"
    ],
    "Packages": [
        "github.com/gokrazy/fbstatus",
        "github.com/gokrazy/hello",
        "github.com/gokrazy/serial-busybox",
        "github.com/gokrazy/breakglass",
        "tailscale.com/cmd/tailscaled",
        "tailscale.com/cmd/tailscale",
        "github.com/gokrazy/mkfs",
        "github.com/gokrazy/wifi",
        "github.com/prometheus/node_exporter"
    ],
    "PackageConfig": {
        "github.com/gokrazy/breakglass": {
            "ExtraFilePaths": {
                "/etc/breakglass.authorized_keys": "breakglass.authorized_keys"
            },
            "CommandLineFlags": [
                "-authorized_keys=/etc/breakglass.authorized_keys"
            ]
        },
        "github.com/gokrazy/gokrazy/cmd/randomd": {
            "ExtraFileContents": {
                "/etc/machine-id": "3e8de745bc7c4cf89cd363e11d9a7718\n"
            }
        },
        "tailscale.com/cmd/tailscale": {
            "CommandLineFlags": [
                "up",
                "--hostname=gok"
            ]
        },
        "github.com/gokrazy/wifi": {
            "ExtraFileContents": {
                "/etc/wifi.json": "{\"ssid\": \"\", \"psk\": \"\"}\n"
            }
        },
        "github.com/prometheus/node_exporter": {
            "CommandLineFlags": [
                "--web.listen-address=:9100"
            ]
        }
    },
    "SerialConsole": "disabled"
}
